{
  "name": "portfolio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --watch --import tsx apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:mcp": "node --import tsx apps/mcp/src/server.ts",
    "start:mcp": "node dist/apps/mcp/src/server.js",
    "board:json": "node dist/apps/mcp/src/cli.js",
    "dev:board:json": "node --import tsx apps/mcp/src/cli.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "start": "node dist/apps/api/src/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --import tsx scripts/database.ts migrate",
    "db:backup": "node --import tsx scripts/database.ts backup",
    "db:restore": "node --import tsx scripts/database.ts restore",
    "db:seed": "node --import tsx scripts/seed.ts",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "package:mcp": "pnpm build:mcp && node scripts/package-mcp.mjs",
    "test:package:mcp": "node --test scripts/package-mcp.test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.10",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fastify": "^5.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "11.0.1"
    }
  }
}
