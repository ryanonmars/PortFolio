# Optional local configuration. Never commit real .env.
# Compose reads this file for interpolation; Node dev reads shell environment.
HOST=127.0.0.1
PORT=3088
DATA_DIR=./data
# Must match browser origin exactly (including hostname and port).
# Set http://127.0.0.1:3090 if using PORT=3090.
# For Vite development use http://127.0.0.1:5173.
# PUBLIC_ORIGIN=http://127.0.0.1:3088
# Optional HTTP loopback access alongside an HTTPS PUBLIC_ORIGIN.
# Compose sets this automatically to its published local port (localhost also works).
# LOCAL_ORIGIN=http://127.0.0.1:3088
