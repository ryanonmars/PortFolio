# Optional local configuration. Never commit real .env.
# Compose reads this file for interpolation; Node dev reads shell environment.
HOST=127.0.0.1
PORT=3088
# Docker publishes on all host interfaces by default. Set 127.0.0.1 for local only.
BIND_ADDRESS=0.0.0.0
DATA_DIR=./data
# Direct HTTP LAN access needs no origin configuration.
# For an HTTPS reverse proxy, preserve Host and set its exact browser origin.
# PUBLIC_ORIGIN=https://portfolio.example.com
# Optional HTTP loopback access alongside an HTTPS PUBLIC_ORIGIN.
# Automatic LAN mode already accepts localhost and private IPs on any valid port.
# LOCAL_ORIGIN=http://127.0.0.1:3088
# Additional exact browser origins for LAN hostnames/IPs or another HTTPS proxy.
# Comma-separated HTTP(S) origins, without paths or trailing slashes.
# ALLOWED_ORIGINS=http://192.0.2.10:3088,http://portfolio.local:3088
# Optional exact hostnames/IPs (optional ports) for stricter deployments.
# When set, other LAN names are denied; configured origins must match this list.
# TRUSTED_HOSTS=dockge.truenas,192.0.2.10:3088,localhost:3088
