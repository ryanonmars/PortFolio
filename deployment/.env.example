# Copy alongside compose.yaml as .env in /mnt/tank/stacks/portfolio.
IMAGE_TAG=v0.1.0
PORT=3088
BIND_ADDRESS=0.0.0.0
DATA_PATH=/mnt/tank/configs/portfolio

# Replace localhost with the server's LAN IP or hostname for remote LAN access.
# Include the published port; omit a trailing slash. Loopback remains available.
PUBLIC_ORIGIN=http://localhost:3088

# Optional additional exact origins, separated by commas, with no paths.
# Example: http://portfolio.local:3088,http://192.0.2.10:3088
ALLOWED_ORIGINS=

# Optional alternatives:
# IMAGE_TAG=latest
# BIND_ADDRESS=127.0.0.1
