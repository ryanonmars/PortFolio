# Copy alongside compose.yaml as .env in /mnt/tank/stacks/portfolio.
IMAGE_TAG=v0.1.0
PORT=3088
BIND_ADDRESS=0.0.0.0
DATA_PATH=/mnt/tank/configs/portfolio

# Optional HTTPS reverse proxy origin; direct HTTP LAN access needs no origin settings.
# PUBLIC_ORIGIN=https://portfolio.example.com

# Optional additional exact origins, separated by commas, with no paths.
# Example: http://portfolio.local:3088,http://192.0.2.10:3088
ALLOWED_ORIGINS=

# Optional strict host list: disables automatic LAN host acceptance when set.
# Exact hostnames/IPs, separated by commas; an optional port restricts that host.
# TRUSTED_HOSTS=dockge.truenas,192.0.2.10:3088,localhost:3088

# Optional alternatives:
# IMAGE_TAG=latest
# BIND_ADDRESS=127.0.0.1
